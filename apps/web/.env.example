# Copier ce fichier en .env.local et renseigner les vraies valeurs.

# --- Formulaire de contact : SMTP -------------------------------------------
# Envoi depuis une boîte OVH du domaine du site, jouan.dev (SPF + DKIM).
# Ne JAMAIS utiliser le SMTP d'un fournisseur d'accès (Orange, SFR, Free…) :
# ils refusent les envois depuis une IP de serveur (« rejected per SPAM
# policy ») et leur DMARC interdit à un tiers d'envoyer en leur nom.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=postmaster@jouan.dev
SMTP_PASS=mot_de_passe_de_la_boite
# Expéditeur affiché dans la boîte de réception : nom libre, adresse = celle
# du compte SMTP.
# Le visiteur est mis en Reply-To, il suffit de « répondre ».
CONTACT_FROM=Site jouan.dev <postmaster@jouan.dev>
# Boîte qui reçoit les demandes.
CONTACT_TO=contact@jouan.dev

# --- SEO --------------------------------------------------------------------
# URL publique (canonical, sitemap, robots, JSON-LD). Lue AU BUILD.
SITE_URL=https://jouan.dev

# --- Mesure d'audience Umami Cloud (sans cookie). Lue AU BUILD. -------------
# Vide en local pour ne pas compter ses propres visites.
UMAMI_WEBSITE_ID=

# --- Accueil personnalisé : base Postgres et administration -----------------
# Base locale (compose.dev.yml)
DATABASE_URL=postgresql://jouan:jouan@127.0.0.1:5433/jouan
# Tests d'intégration du dépôt (base vidée à chaque test)
DATABASE_URL_TEST=postgresql://jouan:jouan@127.0.0.1:5433/jouan_test
# Administration : empreinte (pnpm --filter web empreinte-mot-de-passe) et secret de session (32 caractères au moins)
ADMIN_EMPREINTE=
ADMIN_SECRET=
